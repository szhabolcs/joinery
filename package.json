{
  "name": "joinery",
  "version": "0.6.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@joinery/server' --filter '@joinery/web' dev",
    "dev:server": "bun run --filter '@joinery/server' dev",
    "dev:web": "bun run --filter '@joinery/web' dev",
    "start": "bun run --filter '@joinery/web' build && bun run --filter '@joinery/server' start",
    "typecheck": "bun run --filter '*' typecheck",
    "package": "bun scripts/package-release.ts",
    "build": "bun run --filter '@joinery/web' build && bun run --filter '@joinery/cli' build",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "typescript": "5.9.3"
  }
}
